{
  "name": "e2e",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "e2e": "test-with-playwright --server-path=../server/src/server.js --only-extension=. --test-path=.",
    "e2e:firefox": "test-with-playwright --server-path=../server/src/server.js --only-extension=. --test-path=. --browser=firefox",
    "e2e:firefox:headless": "test-with-playwright --server-path=../server/src/server.js --only-extension=. --test-path=. --browser=firefox --headless",
    "e2e:headless": "test-with-playwright --server-path=../server/src/server.js --only-extension=. --test-path=. --headless",
    "e2e:coverage": "node ../../packages/build/src/build.ts --development && test-with-playwright --server-path=../server/src/server.js --only-extension=. --test-path=. --headless --reuse-page --filter=viewlet.explorer.open",
    "e2e:webkit": "test-with-playwright --server-path=../server/src/server.js --only-extension=. --test-path=. --browser=webkit",
    "e2e:webkit:headless": "test-with-playwright --server-path=../server/src/server.js --only-extension=. --test-path=. --browser=webkit --headless",
    "type-check": "tsc",
    "e2e:scrollbar": "node scripts/scrollbar-drag.mjs"
  },
  "devDependencies": {
    "@lvce-editor/test-with-playwright": "22.42.0",
    "@playwright/test": "1.64.1"
  },
  "dependencies": {
    "@lvce-editor/api": "^9.48.2"
  }
}
