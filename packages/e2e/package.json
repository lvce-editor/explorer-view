    "e2e:webkit": "node scripts/runWebkitTests.ts",
    "e2e:webkit:headless": "node scripts/runWebkitTests.ts --headless",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@lvce-editor/test-with-playwright": "22.32.0"
